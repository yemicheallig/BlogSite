<%- include('../partials/header') %>

    <main class="container py-5">
        <div class="row align-items-center mb-5 g-5">
            <div class="col-md-6">
                <h1 class="display-4 fw-bold text-dark mb-4">About Blogify</h1>
                <p class="text-muted fs-5 mb-4">
                    We are passionate about sharing knowledge, experiences, and insights on topics that matter.
                </p>

                <div class="mb-4">
                    <h5 class="fw-bold text-primary">Our Mission</h5>
                    <p class="text-muted">To create valuable content that informs, inspires, and helps our readers grow.
                    </p>
                </div>

                <div>
                    <h5 class="fw-bold text-primary">Our Vision</h5>
                    <p class="text-muted">To be a trusted source of high-quality content for a global audience.</p>
                </div>
            </div>
            <div class="col-md-6">
                <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=800&q=80"
                    alt="Our Team Workspace" class="img-fluid rounded-4 shadow-sm"
                    style="height: 400px; width: 100%; object-fit: cover;">
            </div>
        </div>

        <!-- Metrics Bar from Figma design (Page 4) -->
        <div class="row g-4 text-center mt-5">
            <div class="col-md-4">
                <div class="p-4 bg-white rounded-3 shadow-sm border-0">
                    <i class="bi bi-journal-richtext text-primary display-5 mb-2"></i>
                    <h3 class="fw-bold m-0">150+</h3>
                    <p class="text-muted m-0">Articles Published</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 bg-white rounded-3 shadow-sm border-0">
                    <i class="bi bi-people text-primary display-5 mb-2"></i>
                    <h3 class="fw-bold m-0">10K+</h3>
                    <p class="text-muted m-0">Readers</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 bg-white rounded-3 shadow-sm border-0">
                    <i class="bi bi-tags text-primary display-5 mb-2"></i>
                    <h3 class="fw-bold m-0">5</h3>
                    <p class="text-muted m-0">Categories</p>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>