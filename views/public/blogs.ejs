<%- include('../partials/header') %>
<style>
    /* Active State Styling */
.category-link.active-category {
    background-color: #0D281E !important; /* Blacked green background for active state */
}

.category-link.active-category .category-text {
    color: #ffffff !important;
}

.category-link.active-category .category-badge {
    background-color: #ffffff !important;
    color: #0D281E !important;
    border-color: #ffffff !important;
}
</style>
    <main class="container py-5">
        <!-- Header Title -->
        <div class="mb-5">
            <% if (searchQuery) { %>
                <p class="text-muted mb-1">Search Results for</p>
                <h1 class="fw-bold">"<%= searchQuery %>"</h1>
                <a href="/blogs" class="text-primary text-decoration-none small">&larr; Clear search and view all
                    posts</a>
                <% } else if (selectedCategory) { %>
                    <p class="text-muted mb-1">Category</p>
                    <h1 class="fw-bold"># <%= selectedCategory %>
                    </h1>
                    <a href="/blogs" class="text-primary text-decoration-none small">&larr; View all posts</a>
                    <% } else { %>
                        <h1 class="fw-bold">All Blog Posts</h1>
                        <p class="text-muted">Read our latest articles and updates</p>
                        <% } %>
        </div>

        <!-- Layout: Posts (Left) & Sidebar Categories (Right) -->
        <div class="row g-5">
            <div class="col-lg-8">
                <% if (posts.length===0) { %>
                    <div class="text-center py-5 bg-white rounded-3 border">
                        <i class="bi bi-journal-x display-1 text-muted mb-3"></i>
                        <h4 class="fw-bold">No articles found</h4>
                        <p class="text-muted">Try adjusting your keywords or browse categories instead.</p>
                    </div>
                    <% } else { %>
                        <!-- Posts List -->
                        <div class="d-flex flex-column gap-4 mb-5">
                            <% posts.forEach(post=> { %>
                                <div class="card border-0 bg-white rounded-3 p-3 hover-card">
                                    <div class="row g-3 align-items-center">
                                        <div class="col-md-4">
                                            <img src="<%= post.featured_image || 'https://images.unsplash.com/photo-1488590528505-98d2b5aba04b?auto=format&fit=crop&w=600&q=80' %>"
                                                class="img-fluid rounded-3 w-100" alt="<%= post.title %>"
                        
                                                style="height: 150px; object-fit: cover;">
                                        </div>
                                        <div class="col-md-8">
                                            <span class="badge bg-light text-primary mb-2">
                                                <%= post.category_name %>
                                            </span>
                                            <h5 class="fw-bold mb-2">
                                                <!-- Note: We will wire this path to `/post/:id` or slug in Task 4.3 -->
                                                <a href="/post/<%= post.id %>" class="text-decoration-none text-dark">
                                                    <%= post.title %>
                                                </a>
                                            </h5>
                                            <p class="text-muted small mb-3">
                                                <%= post.excerpt || (post.title + '...' ) %>
                                            </p>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <small class="text-muted">By <%= post.author_name %> • <%= new
                                                            Date(post.created_at).toLocaleDateString('en-US', {
                                                            month: 'short' , day: 'numeric' , year: 'numeric' }) %>
                                                            </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                        </div>

                        <!-- Pagination Component -->
                        <% if (totalPages> 1) { %>
                            <nav aria-label="Blog navigation">
                                <ul class="pagination justify-content-center">
                                    <!-- Previous Link -->
                                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                        <a class="page-item btn btn-outline-secondary px-3 py-1.5 me-2 rounded-3 <%= currentPage === 1 ? 'disabled' : '' %>"
                                            href="/blogs?page=<%= currentPage - 1 %><%= selectedCategory ? '&category=' + selectedCategory : '' %><%= searchQuery ? '&q=' + searchQuery : '' %>"
                                            aria-label="Previous">
                                            &larr; Previous
                                        </a>
                                    </li>

                                    <!-- Page Numbers -->
                                    <% for(let i=1; i <=totalPages; i++) { %>
                                        <li class="page-item">
                                            <a class="page-link rounded-3 mx-1 <%= currentPage === i ? 'bg-primary text-white border-primary' : 'text-dark border-0 bg-transparent' %>"
                                                href="/blogs?page=<%= i %><%= selectedCategory ? '&category=' + selectedCategory : '' %><%= searchQuery ? '&q=' + searchQuery : '' %>">
                                                <%= i %>
                                            </a>
                                        </li>
                                        <% } %>

                                            <!-- Next Link -->
                                            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                                <a class="page-item btn btn-outline-secondary px-3 py-1.5 ms-2 rounded-3 <%= currentPage === totalPages ? 'disabled' : '' %>"
                                                    href="/blogs?page=<%= currentPage + 1 %><%= selectedCategory ? '&category=' + selectedCategory : '' %><%= searchQuery ? '&q=' + searchQuery : '' %>"
                                                    aria-label="Next">
                                                    Next &rarr;
                                                </a>
                                            </li>
                                </ul>
                            </nav>
                            <% } %>
                                <% } %>
            </div>

            <!-- Sidebar Categories -->
        <div class="col-lg-4">
            <div class="card border-0 bg-white p-4 rounded-4 shadow-sm position-sticky" style="top: 100px;">
                <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">Filter by Category</h5>
                <div class="d-flex flex-column gap-1">
                    <!-- All Categories -->
                    <a href="/blogs"
                        class="category-link d-flex justify-content-between align-items-center py-2 px-3 rounded-3 text-decoration-none <%= !selectedCategory ? 'active-category' : '' %>">
                        <span class="category-text fw-medium">All Categories</span>
                    </a>
        
                    <!-- Individual Categories -->
                    <% categories.forEach(cat=> { %>
                        <a href="/blogs?category=<%= encodeURIComponent(cat.name) %>"
                            class="category-link d-flex justify-content-between align-items-center py-2 px-3 rounded-3 text-decoration-none <%= selectedCategory === cat.name ? 'active-category' : '' %>">
                            <span class="category-text fw-medium"># <%= cat.name %></span>
                            <span class="badge category-badge border rounded-pill px-2.5 py-1.5">
                                <%= cat.count %>
                            </span>
                        </a>
                        <% }) %>
                </div>
            </div>
        </div>
        </div>
    </main>

    <%- include('../partials/footer') %>