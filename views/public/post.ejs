<%- include('../partials/header') %>
    <!-- Modern Font Pair: Plus Jakarta Sans (Headings) + Lora (Editorial Body) -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;1,400&family=Plus+Jakarta+Sans:wght@700;800&display=swap"
        rel="stylesheet">


    <!-- Custom Styling for Interactive Elements & Animations -->
    <style>
        /* Hover Effects for Social Share & Navigation Buttons */
        .share-link {
            transition: transform 0.2s ease, color 0.2s ease;
        }

        .share-link:hover {
            transform: translateY(-2px);
            color: var(--bs-primary) !important;
        }

        .nav-post-link {
            transition: transform 0.25s ease, color 0.25s ease;
            display: inline-block;
        }

        .nav-post-link:hover {
            color: var(--bs-primary-emphasis) !important;
        }

        .nav-post-prev:hover {
            transform: translateX(-4px);
        }

        .nav-post-next:hover {
            transform: translateX(4px);
        }

        /* Soft Entrance Animation */
        .animate-fade-up {
            animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Article Typography Enhancements */
    .post-title {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        letter-spacing: -0.03em;
        line-height: 1.18;
        color: #0F172A; /* Deep dark slate */
    }

    .article-body {
        font-family: 'Lora', Georgia, serif;
        font-size: 1.2rem; /* 19.2px optimal reading size */
        line-height: 1.85; /* Relaxed breathing room */
        color: #2B3442; /* High-contrast readable charcoal */
        letter-spacing: -0.003em;
        max-width: 740px; /* Prevents text lines from getting too wide to scan */
    }

    .article-body p {
        margin-bottom: 1.75rem;
    }

    /* Subtle drop-cap for first character */
    .article-body::first-letter {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 3.4rem;
        font-weight: 800;
        float: left;
        line-height: 0.8;
        margin-right: 0.6rem;
        margin-top: 0.2rem;
        color: #0D281E; /* Blacked green tint */
    }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>

    <main class="container py-5 animate-fade-up" style="max-width: 800px;">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Home</a></li>
                <li class="breadcrumb-item"><a href="/blogs" class="text-decoration-none text-muted">Blogs</a></li>
                <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">
                    <%= post.category_name %>
                </li>
            </ol>
        </nav>

        <!-- Post Header Info -->
        <header class="mb-4">
            <span
                class="badge bg-light text-primary border border-primary-subtle px-3 py-2 rounded-pill mb-3 fw-semibold text-uppercase"
                style="letter-spacing: 0.05em; font-size: 0.75rem;">
                # <%= post.category_name %>
            </span>
        
            <h2 class="post-title fw-extrabold mb-4">
                <%= post.title %>
            </h2>
        
            <div class="d-flex align-items-center gap-3 text-muted pb-2 border-bottom">
                <!-- Author Avatar & Details -->
                <% if (post.author_avatar) { %>
                    <img loading="lazy" decoding="async" src="<%= post.author_avatar %>" alt="<%= post.author_name %>"
                        class="rounded-circle shadow-sm" style="width: 48px; height: 48px; object-fit: cover;">
                    <% } else { %>
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm"
                            style="width: 48px; height: 48px;">
                            <%= post.author_name.charAt(0).toUpperCase() %>
                        </div>
                        <% } %>
        
                            <div>
                                <p class="mb-0 fw-bold text-dark" style="font-family: 'Plus Jakarta Sans', sans-serif;">
                                    <%= post.author_name %>
                                </p>
                                <small class="text-secondary">
                                    <%= new Date(post.created_at).toLocaleDateString('en-US', { month: 'long' , day: 'numeric' ,
                                        year: 'numeric' }) %> • <%= readingTime %> min read
                                </small>
                            </div>
            </div>
        </header>
        
        <!-- Featured Image -->
        <div class="mb-5 overflow-hidden rounded-4 shadow-sm">
            <img loading="lazy" decoding="async"
                src="<%= post.featured_image || 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1200&q=80' %>"
                alt="<%= post.title %>" class="img-fluid w-100"
                style="max-height: 480px; object-fit: cover; transition: transform 0.5s ease;"
                onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
        </div>
        
        <!-- Main Content Body -->
        <article class="article-body mx-auto mb-5" style="white-space: pre-line;">
            <%= post.content %>
        </article>

        <!-- Social Share Buttons -->
        <div class="d-flex align-items-center gap-3 border-top border-bottom py-3 mb-5">
            <span class="fw-semibold text-dark small me-2">Share this article:</span>
            <a href="https://twitter.com/share?url=<%= encodeURIComponent(currentUrl) %>" target="_blank"
                class="text-muted share-link"><i class="bi bi-twitter-x fs-5"></i></a>
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(currentUrl) %>" target="_blank"
                class="text-muted share-link"><i class="bi bi-facebook fs-5"></i></a>
            <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(currentUrl) %>"
                target="_blank" class="text-muted share-link"><i class="bi bi-linkedin fs-5"></i></a>
        </div>

        <!-- Navigation (Prev/Next Articles) -->
        <div class="row pt-4 g-4 border-top">
            <div class="col-md-6 text-start">
                <% if (prevPost) { %>
                    <small class="text-muted text-uppercase tracking-wider d-block mb-1">Previous Article</small>
                    <a href="/post/<%= prevPost.id %>"
                        class="text-decoration-none text-primary fw-bold fs-5 nav-post-link nav-post-prev">
                        &larr; <%= prevPost.title %>
                    </a>
                    <% } %>
            </div>
            <div class="col-md-6 text-end">
                <% if (nextPost) { %>
                    <small class="text-muted text-uppercase tracking-wider d-block mb-1">Next Article</small>
                    <a href="/post/<%= nextPost.id %>"
                        class="text-decoration-none text-primary fw-bold fs-5 nav-post-link nav-post-next">
                        <%= nextPost.title %> &rarr;
                    </a>
                    <% } %>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>