<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Posts - Economixgna</title>
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml"
        href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='16' fill='%230d6efd'/><text x='16' y='21' font-family='Times New Roman, Times, serif' font-size='20' font-weight='bold' fill='white' text-anchor='middle' transform='rotate(-30 16 16)'>E</text></svg>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-color: #2563eb;
            --admin-sidebar-bg: #0f172a;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }

        /* Sidebar Base Styles */
        .sidebar {
            background-color: var(--admin-sidebar-bg);
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1045;
            transition: transform 0.3s ease-in-out;
        }

        .sidebar .nav-link {
            color: #94a3b8;
            border-radius: 6px;
            margin-bottom: 4px;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            color: #fff;
            background-color: #1e293b;
        }

        .main-content {
            padding: 2rem;
            transition: margin-left 0.3s ease-in-out;
        }

        .post-thumbnail {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 6px;
        }

        .badge-published {
            background-color: #dcfce7;
            color: #15803d;
        }

        .badge-draft {
            background-color: #f1f5f9;
            color: #475569;
        }

        /* Mobile specific styles */
        @media (max-width: 767.98px) {
            .sidebar {
                width: 280px;
                transform: translateX(-100%);
            }

            .sidebar.show {
                transform: translateX(0);
            }

            .main-content {
                margin-left: 0;
                padding: 1.25rem;
            }

            .sidebar-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                background: rgba(0, 0, 0, 0.5);
                z-index: 1040;
                display: none;
                opacity: 0;
                transition: opacity 0.3s ease-in-out;
            }

            .sidebar-overlay.show {
                display: block;
                opacity: 1;
            }
        }

        /* Desktop specific styles */
        @media (min-width: 768px) {
            .sidebar {
                transform: translateX(0) !important;
            }

            .main-content {
                margin-left: 25%;
                /* Matches col-md-3 */
            }
        }

        @media (min-width: 992px) {
            .main-content {
                margin-left: 16.66667%;
                /* Matches col-lg-2 */
            }
        }
    </style>
</head>

<body>
    <!-- Overlay for mobile sidebar -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="container-fluid">
        <div class="row">
            <nav id="sidebar" class="col-md-3 col-lg-2 sidebar p-3 text-white">
                <div class="d-flex align-items-center mb-4 pb-2 border-bottom border-secondary">
                    <span class="fs-5 fw-bold">Economixgna</span>
                </div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/dashboard">
                            <i class="bi bi-speedometer2 me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/inbox">
                            <i class="bi bi-inbox me-2"></i> Inbox
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/admin/posts">
                            <i class="bi bi-file-earmark-text me-2"></i> Posts
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/profile">
                            <i class="bi bi-person me-2"></i> Profile
                        </a>
                    </li>
                    <li class="nav-item mt-5">
                        <a class="nav-link text-danger" href="/admin/logout">
                            <i class="bi bi-box-arrow-left me-2"></i> Logout
                        </a>
                    </li>
                </ul>
            </nav>

            <main class="col-12 main-content">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom flex-wrap gap-3">
                    <div class="d-flex align-items-center">
                        <button class="btn btn-outline-secondary d-md-none me-3" id="sidebarToggle">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        <div>
                            <h1 class="h4 fw-bold mb-1">Posts Directory</h1>
                            <p class="text-muted small mb-0">Create, publish, and manage all your articles.</p>
                        </div>
                    </div>
                    <a href="/admin/posts/create" class="btn btn-primary d-flex align-items-center gap-2 btn-sm px-3">
                        <i class="bi bi-plus-lg"></i> Create New Post
                    </a>
                </div>

                <% if (success) { %>
                    <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
                        <%= success %>
                            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"
                                aria-label="Close"></button>
                    </div>
                    <% } %>
                        <% if (error) { %>
                            <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
                                <%= error %>
                                    <button type="button" class="btn-close py-2" data-bs-dismiss="alert"
                                        aria-label="Close"></button>
                            </div>
                            <% } %>

                                <div class="card border-0 shadow-sm mb-4">
                                    <div class="card-body">
                                        <div class="row g-3">
                                            <div class="col-md-8">
                                                <div class="input-group">
                                                    <span class="input-group-text bg-white border-end-0">
                                                        <i class="bi bi-search text-muted"></i>
                                                    </span>
                                                    <input type="text" id="postSearch"
                                                        class="form-control border-start-0"
                                                        placeholder="Search by title, author or category..."
                                                        onkeyup="filterPostsTable()">
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <select id="statusFilter" class="form-select"
                                                    onchange="filterPostsTable()">
                                                    <option value="all">All Statuses</option>
                                                    <option value="published">Published</option>
                                                    <option value="draft">Draft</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card border-0 shadow-sm rounded-3">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0" id="postsTable">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="border-0 ps-4" style="width: 80px;">Cover</th>
                                                    <th class="border-0">Title</th>
                                                    <th class="border-0">Category</th>
                                                    <th class="border-0">Status</th>
                                                    <th class="border-0">Published Date</th>
                                                    <th class="border-0 text-end pe-4" style="width: 200px;">Actions
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (posts.length===0) { %>
                                                    <tr>
                                                        <td colspan="6" class="text-center py-5 text-muted">
                                                            <i class="bi bi-file-earmark-plus fs-1 d-block mb-2"></i>
                                                            No articles found. Write your first masterpiece!
                                                        </td>
                                                    </tr>
                                                    <% } else { %>
                                                        <% posts.forEach(post=> { %>
                                                            <tr class="post-row" data-status="<%= post.status %>">
                                                                <td class="ps-4">
                                                                    <img src="<%= post.featured_image || '/images/default-thumbnail.jpg' %>"
                                                                        class="post-thumbnail" alt="Cover Preview"
                                                                        onerror="this.src='/images/default-thumbnail.jpg'">
                                                                </td>
                                                                <td>
                                                                    <div class="fw-semibold text-dark search-target">
                                                                        <%= post.title %>
                                                                    </div>
                                                                    <div class="text-muted small search-target">By <%=
                                                                            post.author %>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <span
                                                                        class="badge bg-light text-dark border px-2 py-1 search-target">
                                                                        <%= post.category_name || 'Uncategorized' %>
                                                                    </span>
                                                                </td>
                                                                <td>
                                                                    <span
                                                                        class="badge px-2.5 py-1.5 rounded-pill text-capitalize badge-<%= post.status %>">
                                                                        <%= post.status %>
                                                                    </span>
                                                                </td>
                                                                <td class="text-muted small">
                                                                    <%= post.publish_date ? new
                                                                        Date(post.publish_date).toLocaleDateString('en-US',
                                                                        { year: 'numeric' , month: 'short' ,
                                                                        day: 'numeric' }) : '—' %>
                                                                </td>
                                                                <td class="text-end pe-4">
                                                                    <div class="d-flex justify-content-end gap-2">
                                                                        <form
                                                                            action="/admin/posts/toggle-status/<%= post.id %>"
                                                                            method="POST" class="d-inline">
                                                                            <button type="submit"
                                                                                class="btn btn-outline-secondary btn-sm"
                                                                                title="<%= post.status === 'published' ? 'Switch to Draft' : 'Publish Article' %>">
                                                                                <i
                                                                                    class="bi <%= post.status === 'published' ? 'bi-eye-slash' : 'bi-eye' %>"></i>
                                                                            </button>
                                                                        </form>
                                                                        <a href="/admin/posts/edit/<%= post.id %>"
                                                                            class="btn btn-outline-primary btn-sm"
                                                                            title="Edit Post">
                                                                            <i class="bi bi-pencil-square"></i>
                                                                        </a>
                                                                        <form
                                                                            action="/admin/posts/delete/<%= post.id %>"
                                                                            method="POST" class="d-inline"
                                                                            onsubmit="return confirm('Are you sure you want to permanently delete this post? This action is irreversible.');">
                                                                            <button type="submit"
                                                                                class="btn btn-outline-danger btn-sm"
                                                                                title="Delete Post">
                                                                                <i class="bi bi-trash3"></i>
                                                                            </button>
                                                                        </form>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
            </main>
        </div>
    </div>

    <script>
        // Post filtering logic
        function filterPostsTable() {
            const query = document.getElementById('postSearch').value.toLowerCase();
            const statusFilter = document.getElementById('statusFilter').value;
            const rows = document.querySelectorAll('.post-row');

            rows.forEach(row => {
                const rowStatus = row.getAttribute('data-status');

                // Collect text matching targets (title, author, category)
                const searchableElements = row.querySelectorAll('.search-target');
                let matchText = false;
                searchableElements.forEach(el => {
                    if (el.textContent.toLowerCase().includes(query)) {
                        matchText = true;
                    }
                });

                // Evaluate checks
                const matchesStatus = (statusFilter === 'all' || rowStatus === statusFilter);
                const matchesSearch = (query === '' || matchText);

                if (matchesStatus && matchesSearch) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        // Sidebar toggle logic for mobile
        document.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('sidebar');
            const toggleBtn = document.getElementById('sidebarToggle');
            const overlay = document.getElementById('sidebarOverlay');

            function toggleSidebar() {
                sidebar.classList.toggle('show');
                if (overlay.classList.contains('show')) {
                    overlay.style.opacity = '0';
                    setTimeout(() => overlay.classList.remove('show'), 300);
                } else {
                    overlay.classList.add('show');
                    setTimeout(() => overlay.style.opacity = '1', 10);
                }
            }

            toggleBtn.addEventListener('click', toggleSidebar);
            overlay.addEventListener('click', toggleSidebar);
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>