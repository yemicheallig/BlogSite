<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Post - Blogify</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-color: #2563eb;
            --admin-sidebar-bg: #0f172a;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }

        .sidebar {
            background-color: var(--admin-sidebar-bg);
            min-vh-100;
            position: fixed;
        }

        .sidebar .nav-link {
            color: #94a3b8;
            border-radius: 6px;
            margin-bottom: 4px;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            color: #fff;
            background-color: #1e293b;
        }

        .main-content {
            margin-left: 16.66667%;
            padding: 2rem;
        }
    </style>
</head>

<body>

    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-3 col-lg-2 sidebar p-3 text-white">
                <div class="d-flex align-items-center mb-4 pb-2 border-bottom border-secondary">
                    <i class="bi bi-box-fill text-primary fs-4 me-2"></i>
                    <span class="fs-5 fw-bold">Blogify</span>
                </div>
                <ul class="nav flex-column">
                    <li class="nav-item"><a class="nav-link" href="/admin/dashboard"><i
                                class="bi bi-speedometer2 me-2"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/admin/posts"><i
                                class="bi bi-file-earmark-text me-2"></i> Posts</a></li>
                    <li class="nav-item"><a class="nav-link" href="/admin/profile"><i class="bi bi-person me-2"></i>
                            Profile</a></li>
                    <li class="nav-item mt-5"><a class="nav-link text-danger" href="/admin/logout"><i
                                class="bi bi-box-arrow-left me-2"></i> Logout</a></li>
                </ul>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 main-content">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <div>
                        <h1 class="h4 fw-bold mb-1">Create New Post</h1>
                        <p class="text-muted small mb-0">Write and configure a brand new article.</p>
                    </div>
                    <a href="/admin/posts" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                        <i class="bi bi-arrow-left"></i> Back to Directory
                    </a>
                </div>

                <% if (error) { %>
                    <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
                        <%= error %>
                            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"
                                aria-label="Close"></button>
                    </div>
                    <% } %>

                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-body p-4">
                                <form action="/admin/posts/create" method="POST" enctype="multipart/form-data">
                                    <div class="row">
                                        <div class="col-lg-8">
                                            <div class="mb-3">
                                                <label for="title"
                                                    class="form-label fw-semibold text-dark small">Article Title</label>
                                                <input type="text" class="form-control" id="title" name="title"
                                                    placeholder="Enter post title..." required>
                                            </div>

                                            <div class="mb-3">
                                                <label for="summary"
                                                    class="form-label fw-semibold text-dark small">Short Summary</label>
                                                <textarea class="form-control" id="summary" name="summary" rows="3"
                                                    placeholder="Write a brief intro summary for index page previews..."></textarea>
                                            </div>

                                            <div class="mb-3">
                                                <label for="content" class="form-label fw-semibold text-dark small">Full
                                                    Content</label>
                                                <textarea class="form-control" id="content" name="content" rows="12"
                                                    placeholder="Write your full article content here..."
                                                    required></textarea>
                                            </div>
                                        </div>

                                        <div class="col-lg-4 border-start ps-lg-4">
                                            <div class="mb-3">
                                                <label for="category_id"
                                                    class="form-label fw-semibold text-dark small">Category</label>
                                                <select class="form-select" id="category_id" name="category_id">
                                                    <option value="">-- Select Category --</option>
                                                    <% categories.forEach(cat=> { %>
                                                        <option value="<%= cat.id %>">
                                                            <%= cat.name %>
                                                        </option>
                                                        <% }) %>
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label for="status"
                                                    class="form-label fw-semibold text-dark small">Publishing
                                                    Status</label>
                                                <select class="form-select" id="status" name="status">
                                                    <option value="draft" selected>Draft (Save internally)</option>
                                                    <option value="published">Published (Make live instantly)</option>
                                                </select>
                                            </div>

                                            <div class="mb-4">
                                                <label for="featured_image"
                                                    class="form-label fw-semibold text-dark small">Featured
                                                    Image</label>
                                                <input type="file" class="form-control" id="featured_image"
                                                    name="featured_image" accept="image/*"
                                                    onchange="previewImage(event)">
                                                <div class="mt-3">
                                                    <img id="imagePreview" src="#" alt="Preview"
                                                        class="img-fluid rounded border d-none"
                                                        style="max-height: 200px; width: 100%; object-fit: cover;">
                                                </div>
                                            </div>

                                            <div class="d-grid gap-2 pt-2 border-top">
                                                <button type="submit" class="btn btn-primary">Create and Save</button>
                                                <a href="/admin/posts" class="btn btn-light">Cancel</a>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
            </main>
        </div>
    </div>

    <script>
        function previewImage(event) {
            const reader = new FileReader();
            reader.onload = function () {
                const output = document.getElementById('imagePreview');
                output.src = reader.result;
                output.classList.remove('d-none');
            };
            if (event.target.files[0]) {
                reader.readAsDataURL(event.target.files[0]);
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>

